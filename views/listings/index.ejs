
<% layout("/layouts/boilerPlate") %>

<style>
    /* Main filter bar */
    .filter-bar {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        width: 100%;
        margin-top: 1rem;
    }

    /* Filters container */
    #filters {
        display: flex;
        align-items: center;
        gap: 2rem;
        flex: 1;
        min-width: 0;
        padding: 0.5rem 0 1rem;
        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;
        scrollbar-width: none;
    }

    #filters::-webkit-scrollbar {
        display: none;
    }

    /* Individual filters */
    .filter {
        flex: 0 0 auto;
        min-width: 70px;
        text-align: center;
        margin: 0;
        padding: 0.75rem 0.2rem;
        opacity: 0.7;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: opacity 0.2s ease,
                    border-color 0.2s ease;
    }

    .filter i {
        display: block;
        font-size: 1.4rem;
        margin-bottom: 0.5rem;
    }

    .filter p {
        margin: 0;
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .filter:hover,
    .filter.active {
        opacity: 1;
        border-bottom-color: #222;
    }

    /* Tax toggle */
    .tax-toggle {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-shrink: 0;
        border: 1px solid #ccc;
        border-radius: 1rem;
        padding: 0.8rem 1rem;
    }

    .tax-toggle > i {
        font-size: 1.1rem;
    }

    .tax-toggle .form-check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        min-height: auto;
    }

    .tax-toggle .form-check-input {
        float: none;
        margin: 0;
        flex-shrink: 0;
        cursor: pointer;
    }

    .tax-toggle .form-check-label {
        font-size: 0.85rem;
        white-space: nowrap;
        cursor: pointer;
    }

    /* Listing links */
    .listing-link {
        text-decoration: none;
        color: inherit;
    }

    /* Listing cards */
    .card {
        border: none;
        margin-bottom: 2rem;
        transition: opacity 0.2s ease;
    }

    .card-img-top {
        width: 100%;
        height: 20rem;
        object-fit: cover;
        border-radius: 1rem;
    }

    .card:hover {
        opacity: 0.9;
    }

    /* Tax information */
    .tax-info {
        display: none;
        color: #555;
        font-size: 0.85rem;
    }

    /* Tablet */
    @media (max-width: 992px) {
        .filter-bar {
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        #filters {
            flex-basis: 100%;
            gap: 1.4rem;
        }

        .tax-toggle {
            margin-left: auto;
        }
    }

    /* Mobile */
    @media (max-width: 768px) {
        .filter {
            padding: 0.6rem 0.1rem;
        }

        .filter i {
            font-size: 1.25rem;
        }

        .filter p {
            font-size: 0.72rem;
        }

        .card-img-top {
            height: 16rem;
        }

        .tax-toggle {
            padding: 0.65rem 0.8rem;
        }
    }

    /* Small mobile */
    @media (max-width: 480px) {
        #filters {
            gap: 1rem;
        }

        .filter i {
            font-size: 1.1rem;
        }

        .card-img-top {
            height: 14rem;
        }

        .tax-toggle .form-check-label {
            font-size: 0.78rem;
        }
    }
</style>

