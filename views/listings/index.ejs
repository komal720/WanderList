<!-- LISTINGS -->
<div class="row mt-4">

    <% for (let listing of allListing) { %>

        <div class="col-md-4 mb-4">

            <a
                href="/listings/<%= listing._id %>"
                class="listing-link"
            >

                <div class="card">

                    <img
                        src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1510798831971-661eb04b3739?auto=format&fit=crop&w=800&q=80' %>"
                        class="card-img-top"
                        alt="<%= listing.title %>"
                        onerror="this.onerror=null; this.src='https://placehold.co/600x400?text=Image+Not+Available';"
                    >

                    <div class="card-body">

                        <p class="card-text">
                            <strong>
                                <%= listing.title %>
                            </strong>

                            <br>

                            <span class="price"
                                data-price="<%= Number(listing.price || 0) %>">
                                ₹ <%= Number(listing.price || 0).toLocaleString("en-IN") %>
                            </span>

                            <span class="price-unit"> / night</span>

                            <i class="tax-info">
                                &nbsp;including 18% GST
                            </i>
                        </p>

                    </div>

                </div>

            </a>

        </div>

    <% } %>

</div>

<script>
    // Select filter and show underline
    const filters = document.querySelectorAll(".filter");

    filters.forEach((filter) => {
        filter.addEventListener("click", () => {
            filters.forEach((item) => {
                item.classList.remove("active");
            });

            filter.classList.add("active");
        });
    });

    // GST toggle
    const taxSwitch = document.getElementById(
        "flexSwitchCheckChecked"
    );

    const prices = document.querySelectorAll(".price");
    const priceUnits = document.querySelectorAll(".price-unit");
    const taxInfo = document.querySelectorAll(".tax-info");

    function formatPrice(value) {
        return "₹ " + value.toLocaleString("en-IN");
    }

    function updatePrices() {
        prices.forEach((price, index) => {
            const basePrice = Number(price.dataset.price) || 0;

            if (taxSwitch.checked) {
                price.textContent = formatPrice(basePrice);
                priceUnits[index].textContent = " / night";
                taxInfo[index].style.display = "none";
            } else {
                const totalPrice = Math.round(basePrice * 1.18);

                price.textContent = formatPrice(totalPrice);
                priceUnits[index].textContent = " / night ";
                taxInfo[index].style.display = "none";
            }
        });
    }

    if (taxSwitch) {
        taxSwitch.addEventListener("change", updatePrices);
    }
</script>
