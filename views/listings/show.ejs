
<% layout("/layouts/boilerPlate") %>



<div class="row mt-4">
    <div class="col-8 offset-2">

        <h3><%= listing.title %></h3>

        <!-- Listing Card -->
        <div class="card mb-3">

            <img
                src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1510798831971-661eb04b3739' %>"
                class="card-img-top"
                alt="<%= listing.title %>"
                style="height: 20rem; object-fit: cover;"
            >

            <div class="card-body">
                <h5 class="card-title">
                    <%= listing.title %>
                </h5>

                <p class="card-text">
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <strong>Owned By:</strong>
                    <i><%= listing.owner?.username || "Unknown" %></i>
                    <br>

                    <strong>Price:</strong>
                    ₹<%= Number(listing.price).toLocaleString("en-IN") %>
                    / night
                </p>

                <p class="card-text">
                    <strong>Location:</strong>
                    <%= listing.location %>
                </p>

                <p class="card-text">
                    <strong>Country:</strong>
                    <%= listing.country %>
                </p>
            </div>
        </div>

        <!-- Edit and Delete Listing: Only Owner -->
        <% if (
            currUser &&
            listing.owner &&
            listing.owner._id.equals(currUser._id)
        ) { %>

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-danger"
            >
                Edit this Listing
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                class="d-inline"
            >
                <button type="submit" class="btn btn-dark">
                    Delete this Listing
                </button>
            </form>

        <% } %>

        <!-- Review Form -->
        <% if (currUser) { %>

            <div class="mt-4">
                <hr>
                <h4>Leave a Review</h4>

                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                >

                    <!-- Star Rating -->
                    <div class="mb-3">
                        <label class="form-label">Rating</label>

                        <div class="star-rating">
                            <% for (let i = 5; i >= 1; i--) { %>

                                <input
                                    type="radio"
                                    id="star<%= i %>"
                                    name="review[rating]"
                                    value="<%= i %>"
                                    <%= i === 3 ? "checked" : "" %>
                                    required
                                >

                                <label
                                    for="star<%= i %>"
                                    title="<%= i %> stars"
                                >★</label>

                            <% } %>
                        </div>
                    </div>

                    <!-- Comment -->
                    <div class="mb-3">
                        <label for="comment" class="form-label">
                            Comments
                        </label>

                        <textarea
                            name="review[comment]"
                            id="comment"
                            rows="4"
                            class="form-control"
                            placeholder="Write your review here..."
                            required
                        ></textarea>
                    </div>

                    <button
                        type="submit"
                        class="btn btn-outline-dark"
                    >
                        Submit
                    </button>

                </form>
            </div>

        <% } else { %>

            <p class="mt-4">
                <a href="/login">Log in</a>
                to leave a review.
            </p>

        <% } %>

        <!-- All Reviews -->
        <div class="mt-4">
            <hr>
           

            <% if (listing.reviews && listing.reviews.length > 0) { %>
 <h4>All Reviews</h4>
                <div class="row">

                    <% for (let review of listing.reviews) { %>

                        <div class="col-md-6 mb-3">
                            <div class="card h-100">

                                <div class="card-body">

                                    <!-- Review Author -->
                                    <h5>
                                        @<%= review.author?.username || "Unknown" %>
                                    </h5>

                                    <!-- Display Rating Stars -->
                                    <div class="review-stars mb-2">

                                        <% for (let i = 1; i <= 5; i++) { %>

                                            <span class="<%= i <= review.rating ? 'filled-star' : 'empty-star' %>">★</span>

                                        <% } %>

                                        <span class="rating-number">
                                            <%= review.rating %>/5
                                        </span>

                                    </div>

                                    <!-- Review Comment -->
                                    <p class="card-text">
                                        <%= review.comment %>
                                    </p>

                                    <!-- Review Date -->
                                    <small class="text-muted">
                                        <%= review.createdAt
                                            ? review.createdAt.toDateString()
                                            : "" %>
                                    </small>

                                    <br>

                                    <!-- Delete Review: Only Author -->
                                    <% if (
                                        currUser &&
                                        review.author &&
                                        review.author._id.equals(currUser._id)
                                    ) { %>

                                        <form
                                            method="POST"
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        >
                                            <button
                                                type="submit"
                                                class="btn btn-danger btn-sm mt-2"
                                            >
                                                Delete
                                            </button>
                                        </form>

                                    <% } %>

                                </div>
                            </div>
                        </div>

                    <% } %>

                </div>

            <% } else { %>

                <p>No reviews yet.</p>

            <% } %>
        </div>
    </div> <!-- closing main content column -->
</div> <!-- closing row -->

<!-- Map Section -->
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h4>Where you'll be</h4>
        <div id="map" style="height: 400px; width: 100%;"></div>
    </div>
</div>

<script>
    window.listingCoordinates = <%- JSON.stringify(
        listing.geometry?.coordinates || []
    ) %>;
</script>