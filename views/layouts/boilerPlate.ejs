
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


     <!-- Browser tab icon -->
    <link
        rel="icon"
        type="image/svg+xml"
        href="data:image/svg+xml,
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>
            <circle cx='50' cy='50' r='44' fill='%23fe424d'/>
            <path d='M62 32L53 53L32 62L41 41Z'
                  fill='white'
                  stroke='white'
                  stroke-width='5'
                  stroke-linejoin='round'/>
            <circle cx='47' cy='47' r='4' fill='%23fe424d'/>
        </svg>"
    >
    <title> WanderLust</title>
    

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

    <!-- Mapbox CSS -->
    <link
    href="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.css"
    rel="stylesheet"
/>
</head>

<body>

    <!-- Navbar -->
    <%- include("../includes/navbar.ejs") %>

    <!-- Main Container -->
    <div class="container">

        <!-- Flash Messages -->
        <%- include("../includes/flash.ejs") %>

        <!-- Page Content -->
        <%- body %>

    </div>

    <!-- Footer -->
    <%- include("../includes/footer.ejs") %>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Mapbox JavaScript: load only once -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.js"></script>

    <!-- Map Token -->
    <script>
        window.mapToken = "<%= process.env.MAP_TOKEN %>";
    </script>

    <!-- Custom JavaScript -->
    <script src="/js/script.js"></script>

    <!-- Map JavaScript -->
    <script src="/js/map.js"></script>
</body>
</html>
